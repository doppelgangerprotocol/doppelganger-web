# Copy to .env for local dev — never commit .env to git
# On Railway, set these in the dashboard under Variables

FLASK_ENV=development
SECRET_KEY=generate-with-openssl-rand-hex-32

# Railway auto-provides REDIS_URL when you add the Redis plugin
# Locally: redis://localhost:6379
REDIS_URL=redis://localhost:6379

EMBEDDING_SERVICE_URL=https://your-embedding-microservice.com
SESSION_TTL_SECONDS=1800
SIMILARITY_THRESHOLD=0.75

# Primary domain — used to generate one-time links
BASE_URL=localhost-if-not-deployed
